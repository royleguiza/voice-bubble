<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de backup (API <31, android:fullBackupContent): excluye historial de
      dictados, notas de voz (índice + audios + cola pendiente), historial de
      portapapeles e imágenes copiadas. Los ajustes (todo
      FlutterSharedPreferences, incluidos snippets y puentes del teclado) y
      los secretos están excluidos y NO se restauran: tras restaurar hay que
      reconfigurar la app.
      SPK-02: los secretos JAMÁS suben a Drive: se excluye todo sharedpref que
      pueda portarlos (FlutterSharedPreferences + bóveda cifrada
      FlutterSecureStorage, cuyas claves Keystore ni siquiera sobrevivirían a
      una restauración en otro dispositivo). -->
<full-backup-content>
    <exclude domain="file" path="transcription_history.json" />
    <exclude domain="file" path="transcription_history.json.tmp" />
    <exclude domain="file" path="voice_notes.json" />
    <exclude domain="file" path="voice_notes.json.tmp" />
    <exclude domain="file" path="notes_audio" />
    <exclude domain="file" path="pending_notes" />
    <exclude domain="file" path="clipboard_history.json" />
    <exclude domain="file" path="clipboard_history.json.tmp" />
    <exclude domain="file" path="clipboard_media" />
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
</full-backup-content>
