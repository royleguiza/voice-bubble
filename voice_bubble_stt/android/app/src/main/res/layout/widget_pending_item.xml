<?xml version="1.0" encoding="utf-8"?>
<!-- Audio pendiente: la misma tarjeta con el agujero chico y su estado
     en ember-t (design.md §13). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pending_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_note_card_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_hole_bg"
        android:contentDescription="@null">

        <ImageView
            android:id="@+id/widget_pending_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/kb_ic_mic"
            android:tint="@color/hz_on_hole" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/widget_pending_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audio sin transcribir"
            android:textSize="13sp"
            android:textColor="@color/kb_label"
            android:fontFamily="@font/sora"
            android:textFontWeight="600"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_pending_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toca para transcribirlo en la app"
            android:textSize="11sp"
            android:textColor="@color/hz_ember_t"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
