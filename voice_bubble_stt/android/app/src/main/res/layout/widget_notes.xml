<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_notes_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notas"
            android:textSize="14sp"
            android:textColor="@color/kb_label"
            android:fontFamily="@font/sora"
            android:textFontWeight="600"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/widget_notes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 50"
            android:textSize="11sp"
            android:textColor="@color/kb_label_secondary"
            android:fontFamily="@font/jetbrains_mono" />

        <TextView
            android:id="@+id/widget_pending_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/kb_label_secondary"
            android:fontFamily="@font/jetbrains_mono"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Lista con aire en ambos bordes (primera/ultima tarjeta nunca
         cortadas) + separacion real entre tarjetas via divider (los margenes
         en hijos de ListView se ignoran) + difuminado vertical del sistema
         que avisa que hay mas tarjetas abajo/arriba. -->
    <ListView
        android:id="@+id/widget_notes_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="24dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/widget_notes_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Sin notas — toca Dictar para crear la primera"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/kb_label_secondary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/widget_notes_add"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_btn_bg"
            android:contentDescription="Añadir nota">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:tint="@color/hz_ember_t" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_notes_mic_left"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_hole_bg"
            android:contentDescription="Dictar nota"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/kb_ic_mic"
                android:tint="@color/hz_on_hole" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_rec_pill"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_rec_bar_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:visibility="gone">

            <!-- Elemento decorativo visual: el estado de grabación se anuncia en widget_rec_label.
                 Voz del widget (Horizonte fase 4): RemoteViews no admite vistas propias
                 ni dibujo por cuadro, así que cada variante es un ProgressBar
                 indeterminado con un AnimatedVectorDrawable en bucle (el sistema lo anima
                 solo). Agujero a la izquierda y partículas que caen en él dentro de su
                 propio cuadro de 88 dp: nunca pasan por encima del cronómetro ni de la X.
                 El servicio solo alterna la variante visible (goteo / medio / fuerte)
                 cuando cambia el nivel; pensando = anillo girando; sin animaciones del
                 sistema = anillo estático. -->
            <FrameLayout
                android:id="@+id/widget_voice_box"
                android:layout_width="88dp"
                android:layout_height="44dp"
                android:contentDescription="@null">

                <ProgressBar
                    android:id="@+id/widget_voice_low"
                    android:layout_width="88dp"
                    android:layout_height="44dp"
                    android:minWidth="88dp"
                    android:maxWidth="88dp"
                    android:minHeight="44dp"
                    android:maxHeight="44dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_voice_low"
                    android:contentDescription="@null"
                    android:visibility="visible" />

                <ProgressBar
                    android:id="@+id/widget_voice_mid"
                    android:layout_width="88dp"
                    android:layout_height="44dp"
                    android:minWidth="88dp"
                    android:maxWidth="88dp"
                    android:minHeight="44dp"
                    android:maxHeight="44dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_voice_mid"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/widget_voice_high"
                    android:layout_width="88dp"
                    android:layout_height="44dp"
                    android:minWidth="88dp"
                    android:maxWidth="88dp"
                    android:minHeight="44dp"
                    android:maxHeight="44dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_voice_high"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/widget_voice_think"
                    android:layout_width="88dp"
                    android:layout_height="44dp"
                    android:minWidth="88dp"
                    android:maxWidth="88dp"
                    android:minHeight="44dp"
                    android:maxHeight="44dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_voice_think"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_voice_static"
                    android:layout_width="88dp"
                    android:layout_height="44dp"
                    android:src="@drawable/widget_voice_static"
                    android:contentDescription="@null"
                    android:visibility="gone" />
            </FrameLayout>

            <Chronometer
                android:id="@+id/widget_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textSize="12sp"
                android:fontFamily="@font/jetbrains_mono"
                android:textFontWeight="500"
                android:textColor="@color/hz_on_hole" />

            <TextView
                android:id="@+id/widget_rec_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Grabando"
                android:textSize="12sp"
                android:textColor="@color/hz_on_hole"
                android:fontFamily="@font/inter"
                android:textFontWeight="500"
                android:gravity="center_vertical"
                android:paddingStart="6dp" />

            <ImageView
                android:id="@+id/widget_cancel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/widget_ic_x"
                android:padding="12dp"
                android:contentDescription="Cancelar grabación" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_notes_add_right"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_btn_bg"
            android:contentDescription="Añadir nota"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:tint="@color/hz_ember_t" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_bottom_spacer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <FrameLayout
            android:id="@+id/widget_notes_mic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_hole_bg"
            android:contentDescription="Dictar nota">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/kb_ic_mic"
                android:tint="@color/hz_on_hole" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
