<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_notes_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notas"
            android:textSize="12sp"
            android:textColor="@color/kb_label"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/widget_notes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 50"
            android:textSize="10sp"
            android:textColor="@color/kb_label_secondary"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <TextView
            android:id="@+id/widget_pending_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="@color/kb_label_secondary"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Lista con aire en ambos bordes (primera/ultima tarjeta nunca
         cortadas) + separacion real entre tarjetas via divider (los margenes
         en hijos de ListView se ignoran) + difuminado vertical del sistema
         que avisa que hay mas tarjetas abajo/arriba. -->
    <ListView
        android:id="@+id/widget_notes_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="24dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/widget_notes_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Sin notas — toca Dictar para crear la primera"
        android:textSize="11sp"
        android:textColor="@color/kb_label_secondary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/widget_notes_add"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="Añadir nota">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:tint="#007AFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_notes_mic_left"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="Dictar nota"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:tint="#007AFF" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_rec_pill"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_rec_bar_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_rec_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/widget_rec_dot"
                android:contentDescription="@null" />

            <Chronometer
                android:id="@+id/widget_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/kb_label" />

            <TextView
                android:id="@+id/widget_rec_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Grabando"
                android:textSize="11sp"
                android:textColor="@color/kb_label"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:paddingStart="6dp" />

            <ImageView
                android:id="@+id/widget_cancel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/widget_ic_x"
                android:padding="12dp"
                android:contentDescription="Cancelar grabación" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_notes_add_right"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="Añadir nota"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:tint="#007AFF" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_bottom_spacer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <FrameLayout
            android:id="@+id/widget_notes_mic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="Dictar nota">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:tint="#007AFF" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
