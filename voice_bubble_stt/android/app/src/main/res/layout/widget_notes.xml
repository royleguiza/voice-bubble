<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_notes_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notas"
            android:textSize="12sp"
            android:textColor="#0B1220"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/widget_notes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 50"
            android:textSize="10sp"
            android:textColor="#6B7A90"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_notes_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_note_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_note_card_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/widget_note_title_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin notas"
                android:textSize="12sp"
                android:textColor="#0B1220"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_note_body_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toca Dictar para crear la primera nota"
                android:textSize="11sp"
                android:textColor="#6B7A90"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_note_time_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="#6B7A90"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_note_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_note_card_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_note_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#0B1220"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_note_body_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#6B7A90"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_note_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="#6B7A90"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_note_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_note_card_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_note_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#0B1220"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_note_body_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#6B7A90"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_note_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="#6B7A90"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/widget_notes_add"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="Añadir nota">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:tint="#007AFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_notes_mic_left"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="Dictar nota"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:tint="#007AFF" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_rec_pill"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_rec_bar_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_rec_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/widget_rec_dot"
                android:contentDescription="@null" />

            <Chronometer
                android:id="@+id/widget_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0B1220" />

            <TextView
                android:id="@+id/widget_rec_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Grabando"
                android:textSize="11sp"
                android:textColor="#0B1220"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:paddingStart="6dp" />

            <ImageView
                android:id="@+id/widget_cancel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_x"
                android:tint="#FFFF3B30"
                android:padding="12dp"
                android:contentDescription="Cancelar grabación" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_notes_mic_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dictar nota"
            android:textSize="11sp"
            android:textColor="#6B7A90"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="6dp" />

        <FrameLayout
            android:id="@+id/widget_notes_add_right"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="Añadir nota"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:tint="#007AFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_notes_mic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="Dictar nota">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:tint="#007AFF" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
