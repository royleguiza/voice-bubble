<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_notes_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notas"
            android:textSize="14sp"
            android:textColor="@color/kb_label"
            android:fontFamily="@font/sora"
            android:textFontWeight="600"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/widget_notes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 50"
            android:textSize="11sp"
            android:textColor="@color/kb_label_secondary"
            android:fontFamily="@font/jetbrains_mono" />

        <TextView
            android:id="@+id/widget_pending_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/kb_label_secondary"
            android:fontFamily="@font/jetbrains_mono"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Lista con aire en ambos bordes (primera/ultima tarjeta nunca
         cortadas) + separacion real entre tarjetas via divider (los margenes
         en hijos de ListView se ignoran) + difuminado vertical del sistema
         que avisa que hay mas tarjetas abajo/arriba. -->
    <ListView
        android:id="@+id/widget_notes_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="24dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/widget_notes_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Sin notas — toca Dictar para crear la primera"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/kb_label_secondary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/widget_notes_add"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_btn_bg"
            android:contentDescription="Añadir nota">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:tint="@color/hz_ember_t" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_notes_mic_left"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_hole_bg"
            android:contentDescription="Dictar nota"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/kb_ic_mic"
                android:tint="@color/hz_on_hole" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_rec_pill"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_rec_bar_bg"
            android:padding="2dp"
            android:visibility="gone">

            <!-- Elemento decorativo (la voz animada). Sin texto visible: el estado (grabando / procesando / guardado) se
                 anuncia por contentDescription de widget_voice_box (lo fija el provider).
                 Voz del widget: RemoteViews no admite vistas propias ni dibujo por
                 cuadro, así que cada variante es un ProgressBar indeterminado con un
                 AnimatedVectorDrawable en bucle (el sistema lo anima solo).
                 Capas (de abajo arriba): campo de partículas a TODO el ancho de la
                 píldora (grabando: nacen a la derecha, bajo la X, y viajan a la
                 izquierda hacia el agujero; pensando: rayitas nacen en el agujero y
                 van a la derecha) -> agujero fijo de 44dp (no se estira) -> cronómetro
                 centrado con respaldo oscuro difuso -> X con halo oscuro circular.
                 El padding de 2dp deja libre el borde de brasa. -->
            <FrameLayout
                android:id="@+id/widget_voice_box"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Grabando">

                <ProgressBar
                    android:id="@+id/widget_voice_low"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:maxWidth="2000dp"
                    android:minHeight="44dp"
                    android:maxHeight="44dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_voice_low"
                    android:contentDescription="@null"
                    android:visibility="visible" />

                <ProgressBar
                    android:id="@+id/widget_voice_mid"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:maxWidth="2000dp"
                    android:minHeight="44dp"
                    android:maxHeight="44dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_voice_mid"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/widget_voice_high"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:maxWidth="2000dp"
                    android:minHeight="44dp"
                    android:maxHeight="44dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_voice_high"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/widget_voice_think"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:maxWidth="2000dp"
                    android:minHeight="44dp"
                    android:maxHeight="44dp"
                    android:indeterminate="true"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/widget_voice_think"
                    android:contentDescription="@null"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/widget_voice_static"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/widget_voice_static"
                android:contentDescription="@null" />

            <!-- Pensando: arco que gira sobre el agujero (como spinArc de HorizonView). -->
            <ProgressBar
                android:id="@+id/widget_voice_spin"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:minWidth="44dp"
                android:maxWidth="44dp"
                android:minHeight="44dp"
                android:maxHeight="44dp"
                android:indeterminate="true"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/widget_voice_spin"
                android:contentDescription="@null"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/widget_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/widget_rec_halo"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="12sp"
                android:fontFamily="@font/jetbrains_mono"
                android:textFontWeight="500"
                android:textColor="@color/hz_on_hole" />

            <ImageView
                android:id="@+id/widget_cancel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/widget_rec_halo"
                android:src="@drawable/widget_ic_x"
                android:padding="12dp"
                android:contentDescription="Cancelar grabación" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_notes_add_right"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_btn_bg"
            android:contentDescription="Añadir nota"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:tint="@color/hz_ember_t" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_bottom_spacer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <FrameLayout
            android:id="@+id/widget_notes_mic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_hole_bg"
            android:contentDescription="Dictar nota">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/kb_ic_mic"
                android:tint="@color/hz_on_hole" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
