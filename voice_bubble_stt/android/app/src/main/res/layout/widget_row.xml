<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/widget_row_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_mic_bg">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:tint="#007AFF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widget_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tocar para dictar"
            android:textSize="12sp"
            android:textColor="#0B1220"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_row_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Whisper turbo"
            android:textSize="10sp"
            android:textColor="#6B7A90"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="11sp"
        android:textColor="#6B7A90"
        android:background="@drawable/widget_pill_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

</LinearLayout>
