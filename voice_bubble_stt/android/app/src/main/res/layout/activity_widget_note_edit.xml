<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:fitsSystemWindows="true">

    <!-- La tarjeta consume sus toques para que no burbujeen al
         overlay_root (que cierra igual que la X). -->
    <LinearLayout
        android:id="@+id/note_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="12dp"
        android:background="@drawable/widget_glass_inner"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp"
        android:elevation="16dp">

        <!-- C-40: tirador para ampliar solo el cuerpo de la nota.
             Zona táctil de 48dp; la píldora visual es sutil. -->
        <FrameLayout
            android:id="@+id/btn_expand_handle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="-14dp"
            android:contentDescription="Arrastrar para ampliar">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:alpha="0.4"
                android:background="@drawable/widget_grabber_pill" />
        </FrameLayout>

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva nota"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/kb_label" />

        <LinearLayout
            android:id="@+id/edit_title_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <com.royleguiza.voicebubblestt.DismissEditText
                android:id="@+id/edit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Sin título"
                android:textSize="13sp"
                android:textColor="@color/kb_label"
                android:textColorHint="@color/kb_label_secondary"
                android:background="@drawable/widget_note_card_bg"
                android:padding="11dp"
                android:maxLines="1"
                android:inputType="text" />
        </LinearLayout>

        <com.royleguiza.voicebubblestt.DismissEditText
            android:id="@+id/edit_body"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:hint="Escribir nota…"
            android:textSize="13sp"
            android:textColor="@color/kb_label"
            android:textColorHint="@color/kb_label_secondary"
            android:background="@drawable/widget_note_card_bg"
            android:padding="11dp"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <!-- C-46: reproductor expandible del pendiente (solo modo pendiente).
             Vive DENTRO de la botonera, no en una fila propia: asi no empuja
             la botonera hacia abajo. Al tocarla, el grupo crece desde el play
             central y los dos espaciadores de peso ceden terreno, con lo que
             la X de cerrar (izq) y Transcribir (der) se separan solas hacia
             los costados sin salirse de la tarjeta. Nunca se solapan.
             Estructura: pausa | reloj | X, ancho del reloj y de la X en 0
             cuando está colapsado. -->
        <LinearLayout
            android:id="@+id/pending_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Grupo izquierdo: cerrar la modal + descartar. -->
            <LinearLayout
                android:id="@+id/player_group_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/pending_cancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Cancelar">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_x" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/pending_delete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Eliminar nota">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_delete" />
                </FrameLayout>
            </LinearLayout>

            <!-- Espaciador izquierdo: cede terreno al abrirse el player. -->
            <Space
                android:id="@+id/player_spacer_left"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/player_bar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btn_player_main"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Reproducir audio">

                    <ImageView
                        android:id="@+id/player_main_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_play" />
                </FrameLayout>

                <TextView
                    android:id="@+id/player_clock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:text="00:00 / 00:00"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/kb_label" />

                <FrameLayout
                    android:id="@+id/btn_player_close"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Cerrar reproductor">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_x" />
                </FrameLayout>
            </LinearLayout>

            <!-- Espaciador derecho: cede terreno al abrirse el player. -->
            <Space
                android:id="@+id/player_spacer_right"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Grupo derecho: transcribir. -->
            <FrameLayout
                android:id="@+id/pending_transcribe"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_note_card_bg"
                android:contentDescription="Transcribir ahora"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_audio" />
            </FrameLayout>
        </LinearLayout>

        <!-- Botonera clásica para los otros modos (nota normal). Cada botón
             vive en un slot de igual peso, asi los visibles quedan siempre a
             la misma distancia entre si (2, 3 o 4 segun el modo). Oculta por
             defecto: el modo pendiente usa la fila de arriba. -->
        <LinearLayout
            android:id="@+id/classic_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_cancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Cancelar">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_x" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btn_delete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Eliminar nota">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_delete" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_play"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btn_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Reproducir audio">

                    <ImageView
                        android:id="@+id/widget_play_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_play" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_transcribe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btn_transcribe"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Transcribir ahora">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_audio" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_gemini_investigar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_gemini_investigar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Investigar con IA">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_globe" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_gemini_reestructurar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_gemini_reestructurar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Reestructurar con IA">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_restructure" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_copy"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Copiar contenido">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_copy" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_save"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_note_card_bg"
                    android:contentDescription="Guardar nota">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_check" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
