<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja de edición del widget (Horizonte fase 4, design.md §14): hoja
     sólida bg + line radio 30 con agarradera line, campos surf + line
     radio 18 y botones de ícono circulares surf + line; guardar es el
     único en brasa (check on-ember). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:fitsSystemWindows="true">

    <!-- La tarjeta consume sus toques para que no burbujeen al
         overlay_root (que cierra igual que la X). -->
    <LinearLayout
        android:id="@+id/note_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="12dp"
        android:background="@drawable/widget_sheet_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- C-40: tirador para ampliar solo el cuerpo de la nota.
             Zona táctil de 48dp; la píldora visual es sutil. -->
        <FrameLayout
            android:id="@+id/btn_expand_handle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="-16dp"
            android:layout_marginBottom="-18dp"
            android:contentDescription="@string/widget_edit_drag_expand">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_grabber_pill" />
        </FrameLayout>

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_new_note"
            android:textSize="17sp"
            android:fontFamily="@font/sora"
            android:textFontWeight="600"
            android:textColor="@color/kb_label" />

        <LinearLayout
            android:id="@+id/edit_title_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <com.royleguiza.voicebubblestt.DismissEditText
                android:id="@+id/edit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/widget_untitled"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:textColor="@color/kb_label"
                android:textColorHint="@color/kb_label_secondary"
                android:background="@drawable/widget_field_bg"
                android:padding="11dp"
                android:maxLines="1"
                android:inputType="text" />
        </LinearLayout>

        <com.royleguiza.voicebubblestt.DismissEditText
            android:id="@+id/edit_body"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:hint="@string/widget_write_hint"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/kb_label"
            android:textColorHint="@color/kb_label_secondary"
            android:background="@drawable/widget_field_bg"
            android:padding="11dp"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <!-- C-46: reproductor expandible del pendiente (solo modo pendiente).
             Vive DENTRO de la botonera, no en una fila propia: asi no empuja
             la botonera hacia abajo. Al tocarla, el grupo crece desde el play
             central y los dos espaciadores de peso ceden terreno, con lo que
             la X de cerrar (izq) y Transcribir (der) se separan solas hacia
             los costados sin salirse de la tarjeta. Nunca se solapan.
             Estructura: pausa | reloj | X, ancho del reloj y de la X en 0
             cuando está colapsado. -->
        <LinearLayout
            android:id="@+id/pending_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Grupo izquierdo: cerrar la modal + descartar. -->
            <LinearLayout
                android:id="@+id/player_group_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/pending_cancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_cancel">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_x"
                        android:tint="@color/hz_fg2" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/pending_delete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_delete_note">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_delete" />
                </FrameLayout>
            </LinearLayout>

            <!-- Espaciador izquierdo: cede terreno al abrirse el player. -->
            <Space
                android:id="@+id/player_spacer_left"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/player_bar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btn_player_main"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_play_audio">

                    <ImageView
                        android:id="@+id/player_main_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_play" />
                </FrameLayout>

                <TextView
                    android:id="@+id/player_clock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:text="00:00 / 00:00"
                    android:textSize="14sp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textFontWeight="500"
                    android:textColor="@color/kb_label" />

                <FrameLayout
                    android:id="@+id/btn_player_close"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_close_player">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_x"
                        android:tint="@color/hz_fg2" />
                </FrameLayout>
            </LinearLayout>

            <!-- Espaciador derecho: cede terreno al abrirse el player. -->
            <Space
                android:id="@+id/player_spacer_right"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Grupo derecho: transcribir. -->
            <FrameLayout
                android:id="@+id/pending_transcribe"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_sheet_btn_bg"
                android:contentDescription="@string/widget_transcribe_now"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_audio" />
            </FrameLayout>
        </LinearLayout>

        <!-- Botonera clásica para los otros modos (nota normal). Cada botón
             vive en un slot de igual peso, asi los visibles quedan siempre a
             la misma distancia entre si (2, 3 o 4 segun el modo). Oculta por
             defecto: el modo pendiente usa la fila de arriba. -->
        <LinearLayout
            android:id="@+id/classic_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_cancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_cancel">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_x"
                        android:tint="@color/hz_fg2" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btn_delete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_delete_note">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_delete" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_play"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btn_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_play_audio">

                    <ImageView
                        android:id="@+id/widget_play_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_play" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_transcribe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/btn_transcribe"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_transcribe_now">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_audio" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_gemini_titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_gemini_titulo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_ai_title">

                    <ImageView
                        android:id="@+id/icon_gemini_titulo"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_title" />

                    <ProgressBar
                        android:id="@+id/progress_gemini_titulo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/widget_ai_title_loading"
                        android:indeterminateDuration="2000"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_gemini_resumir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_gemini_resumir"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_ai_summary">

                    <ImageView
                        android:id="@+id/icon_gemini_resumir"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_restructure" />

                    <ProgressBar
                        android:id="@+id/progress_gemini_resumir"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/widget_ai_summary_loading"
                        android:indeterminateDuration="2000"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_copy"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_sheet_btn_bg"
                    android:contentDescription="@string/widget_copy_content">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_copy" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/slot_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_save"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_primary_bg"
                    android:contentDescription="@string/widget_save_note">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/widget_ic_check" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Confirmar eliminar DENTRO de la hoja (reemplaza a la botonera
             clásica mientras se pregunta): no abre otra ventana, así que el
             teclado no se esconde y la hoja no salta. Dos píldoras iguales:
             Cancelar surf2 y Eliminar danger (design.md §14). -->
        <LinearLayout
            android:id="@+id/delete_confirm_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/delete_confirm_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/widget_delete_body"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/kb_label_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_delete_cancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_secondary_bg"
                    android:gravity="center"
                    android:text="@string/widget_cancel"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="500"
                    android:textColor="@color/kb_label" />

                <TextView
                    android:id="@+id/btn_delete_confirm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/widget_danger_bg"
                    android:gravity="center"
                    android:text="@string/widget_delete"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textFontWeight="600"
                    android:textColor="@color/kb_label_on_danger" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
