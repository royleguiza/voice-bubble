<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="12dp"
        android:background="@drawable/widget_glass_inner"
        android:orientation="vertical"
        android:padding="14dp"
        android:elevation="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva nota"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/kb_label" />

        <LinearLayout
            android:id="@+id/edit_title_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/edit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Sin título"
                android:textSize="13sp"
                android:textColor="@color/kb_label"
                android:textColorHint="@color/kb_label_secondary"
                android:background="@drawable/widget_note_card_bg"
                android:padding="11dp"
                android:maxLines="1"
                android:inputType="text" />
        </LinearLayout>

        <EditText
            android:id="@+id/edit_body"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:hint="Escribir nota…"
            android:textSize="13sp"
            android:textColor="@color/kb_label"
            android:textColorHint="@color/kb_label_secondary"
            android:background="@drawable/widget_note_card_bg"
            android:padding="11dp"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/btn_cancel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_note_card_bg"
                android:contentDescription="Cancelar">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_x" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/btn_copy"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_note_card_bg"
                android:contentDescription="Copiar contenido">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_copy" />
            </FrameLayout>

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/btn_save"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_note_card_bg"
                android:contentDescription="Guardar nota">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_check" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
