<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="12dp"
        android:background="@drawable/widget_glass_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:elevation="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva nota"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#0B1220" />

        <LinearLayout
            android:id="@+id/edit_title_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/edit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Título"
                android:textSize="13sp"
                android:textColor="#0B1220"
                android:textColorHint="#6B7A90"
                android:background="@drawable/widget_note_card_bg"
                android:padding="11dp"
                android:maxLines="1"
                android:inputType="text" />
        </LinearLayout>

        <EditText
            android:id="@+id/edit_body"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:hint="Escribir nota…"
            android:textSize="13sp"
            android:textColor="#0B1220"
            android:textColorHint="#6B7A90"
            android:background="@drawable/widget_note_card_bg"
            android:padding="11dp"
            android:gravity="top"
            android:inputType="textMultiLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/btn_cancel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_pill_bg"
                android:contentDescription="Cancelar">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_x"
                    android:tint="#FFFF3B30" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/btn_save"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_pill_bg"
                android:contentDescription="Guardar nota">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
