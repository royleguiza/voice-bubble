<?xml version="1.0" encoding="utf-8"?>
<!-- Pastilla del micrófono grabando/pensando (Horizonte fase 1, design.md §8):
     fondo agujero (también en claro) con anillo de brasa; presionada, destello.
     HorizonView dibuja la animación A encima. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="23dp" />
            <solid android:color="@color/hz_hole" />
            <stroke
                android:width="1.5dp"
                android:color="@color/hz_hot" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="23dp" />
            <solid android:color="@color/hz_hole" />
            <stroke
                android:width="1.5dp"
                android:color="@color/hz_ember" />
        </shape>
    </item>
</selector>
