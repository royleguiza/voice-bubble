<?xml version="1.0" encoding="utf-8"?>
<!-- Modo mini (MEJ-12): teclado + flecha hacia abajo = compactar.
     Estilo de trazo de ic_keyboard (24dp, round, tint kb_label). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/kb_label">
    <!-- Mini teclado superior -->
    <path
        android:fillColor="#00000000"
        android:pathData="M4,3.5 H20 V11 H4 Z"
        android:strokeColor="@color/kb_label"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />
    <!-- Puntos de teclas -->
    <path
        android:fillColor="#00000000"
        android:pathData="M7,7 H9 M11,7 H13 M15,7 H17"
        android:strokeColor="@color/kb_label"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.0" />
    <!-- Flecha hacia abajo -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,13.5 V20.5 M8.2,17 L12,20.8 L15.8,17"
        android:strokeColor="@color/kb_label"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.0" />
</vector>
