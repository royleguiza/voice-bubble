<?xml version="1.0" encoding="utf-8"?>
<!-- Fin de la traducción (Ruta IA 2b): sigue al cargador del widget
     (kb_translate_loading, letras en órbita) con el mismo agujero y la
     misma órbita inclinada. La órbita se cierra sobre el agujero (lo que
     giraba «cae adentro»), el anillo brasa late una vez y se dibuja el ✓
     en destello. 48 dp, ≈ 760 ms; después la barra vuelve al ícono. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp"
            android:viewportWidth="48" android:viewportHeight="48">
            <!-- Mismo agrandado que kb_translate_loading (×1.45): en la barra
                 el lienzo se achica al alto del botón. -->
            <group android:pivotX="24" android:pivotY="24" android:scaleX="1.45" android:scaleY="1.45">
            <!-- Halo brasa (igual al cargador) -->
            <group android:name="halo" android:pivotX="24" android:pivotY="24">
                <path android:pathData="M11,24a13,13 0 1,0 26,0a13,13 0 1,0 -26,0z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="radial" android:centerX="24" android:centerY="24"
                            android:gradientRadius="13">
                            <item android:offset="0.4" android:color="#38FF8A1F" />
                            <item android:offset="1" android:color="#00FF8A1F" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
            <!-- Órbita inclinada: se cierra sobre el agujero -->
            <group android:name="orbit" android:pivotX="24" android:pivotY="24"
                android:rotation="-18.33">
                <path android:name="orbitPath" android:strokeColor="@color/hz_ember"
                    android:strokeAlpha="0.45" android:strokeWidth="0.8"
                    android:pathData="M13,24a11,4.4 0 1,0 22,0a11,4.4 0 1,0 -22,0" />
            </group>
            <!-- Agujero y anillo brasa -->
            <path android:fillColor="@color/hz_hole"
                android:pathData="M18.8,24a5.2,5.2 0 1,0 10.4,0a5.2,5.2 0 1,0 -10.4,0z" />
            <group android:name="ring" android:pivotX="24" android:pivotY="24">
                <path android:strokeColor="@color/hz_ember" android:strokeWidth="1.3"
                    android:pathData="M19.45,24a4.55,4.55 0 1,0 9.1,0a4.55,4.55 0 1,0 -9.1,0" />
            </group>
            <!-- ✓ en destello, dentro del agujero -->
            <path android:name="check" android:strokeColor="@color/hz_hot"
                android:strokeWidth="1.4" android:strokeLineCap="round"
                android:strokeLineJoin="round" android:trimPathEnd="0"
                android:pathData="M21.6,24.2L23.3,25.9L26.5,22.3" />
            </group>
        </vector>
    </aapt:attr>
    <!-- La órbita se achica hasta el borde del agujero y se apaga -->
    <target android:name="orbit">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="280"
                    android:valueFrom="1" android:valueTo="0.42" android:valueType="floatType"
                    android:interpolator="@android:interpolator/accelerate_cubic" />
                <objectAnimator android:propertyName="scaleY" android:duration="280"
                    android:valueFrom="1" android:valueTo="0.42" android:valueType="floatType"
                    android:interpolator="@android:interpolator/accelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="orbitPath">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:duration="300"
                android:valueFrom="0.45" android:valueTo="0" android:valueType="floatType"
                android:interpolator="@android:interpolator/accelerate_quad" />
        </aapt:attr>
    </target>
    <!-- El halo se recoge con la órbita -->
    <target android:name="halo">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="300"
                    android:valueFrom="1" android:valueTo="0.6" android:valueType="floatType" />
                <objectAnimator android:propertyName="scaleY" android:duration="300"
                    android:valueFrom="1" android:valueTo="0.6" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <!-- El anillo late una vez cuando todo cayó adentro -->
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set>
                    <objectAnimator android:propertyName="scaleX" android:duration="160"
                        android:startOffset="260" android:valueFrom="1" android:valueTo="1.22"
                        android:valueType="floatType"
                        android:interpolator="@android:interpolator/decelerate_quad" />
                    <objectAnimator android:propertyName="scaleY" android:duration="160"
                        android:startOffset="260" android:valueFrom="1" android:valueTo="1.22"
                        android:valueType="floatType"
                        android:interpolator="@android:interpolator/decelerate_quad" />
                </set>
                <set>
                    <objectAnimator android:propertyName="scaleX" android:duration="220"
                        android:valueFrom="1.22" android:valueTo="1" android:valueType="floatType"
                        android:interpolator="@android:interpolator/accelerate_decelerate" />
                    <objectAnimator android:propertyName="scaleY" android:duration="220"
                        android:valueFrom="1.22" android:valueTo="1" android:valueType="floatType"
                        android:interpolator="@android:interpolator/accelerate_decelerate" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <!-- El ✓ se dibuja con el latido -->
    <target android:name="check">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:duration="260"
                android:startOffset="300" android:valueFrom="0" android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>
</animated-vector>
