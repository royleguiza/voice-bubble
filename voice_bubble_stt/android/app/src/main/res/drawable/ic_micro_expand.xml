<?xml version="1.0" encoding="utf-8"?>
<!-- Modo mini (MEJ-12): teclado + flecha hacia arriba = expandir al completo.
     Espejo de ic_micro_collapse, mismo estilo de trazo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/kb_label">
    <!-- Flecha hacia arriba -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,10.5 V3.5 M8.2,7 L12,3.2 L15.8,7"
        android:strokeColor="@color/kb_label"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.0" />
    <!-- Mini teclado inferior -->
    <path
        android:fillColor="#00000000"
        android:pathData="M4,13 H20 V20.5 H4 Z"
        android:strokeColor="@color/kb_label"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />
    <!-- Puntos de teclas -->
    <path
        android:fillColor="#00000000"
        android:pathData="M7,17 H9 M11,17 H13 M15,17 H17"
        android:strokeColor="@color/kb_label"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.0" />
</vector>
