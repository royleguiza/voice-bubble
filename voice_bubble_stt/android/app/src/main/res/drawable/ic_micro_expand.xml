<?xml version="1.0" encoding="utf-8"?>
<!-- Agrandar a completo (opción Barra del dueño, path full de la maqueta):
     contorno atenuado + grilla de teclas y barra.
     Horizonte fase 2: trazo 1.8 sobre viewport 24, extremos y uniones
     redondeados (paths de laboratorio_ui/horizonte.html, objeto P). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/kb_label">
    <!-- Contorno atenuado (opacity .4) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M6.5,5h11a3.5,3.5 0 0,1 3.5,3.5v7a3.5,3.5 0 0,1 -3.5,3.5h-11a3.5,3.5 0 0,1 -3.5,-3.5v-7a3.5,3.5 0 0,1 3.5,-3.5z"
