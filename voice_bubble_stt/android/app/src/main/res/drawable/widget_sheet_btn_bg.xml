<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de ícono parejo de la hoja de edición: surf + line, radio 10;
     presionado en surf2. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/hz_surf2" />
            <stroke android:width="1dp" android:color="@color/hz_line" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/hz_surf" />
            <stroke android:width="1dp" android:color="@color/hz_line" />
        </shape>
    </item>
</selector>
