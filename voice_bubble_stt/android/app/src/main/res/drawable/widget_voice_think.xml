<?xml version="1.0" encoding="utf-8"?>
<!-- GENERADO por gen_widget_voice.py (fase 4, fuera del repo). Voz del widget:
     ProgressBar indeterminado -> AnimatedVectorDrawable en bucle (RemoteViews
     no admite vistas propias ni dibujo por cuadro). Variante: think. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="88dp" android:height="44dp"
            android:viewportWidth="88" android:viewportHeight="44">
            <path android:name="hole" android:fillColor="@color/hz_hole"
                android:strokeColor="@color/hz_ember" android:strokeWidth="2"
                android:pathData="M11,22a11,11 0 1,0 22,0a11,11 0 1,0 -22,0z" />
            <group android:name="spin" android:pivotX="22" android:pivotY="22">
                <path android:name="arc" android:strokeColor="@color/hz_hot" android:strokeWidth="3"
                    android:strokeLineCap="round" android:pathData="M22.00,7.00A15,15 0 0,1 34.99,29.50" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="spin">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1100" android:repeatCount="infinite"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="rotation" android:valueFrom="0" android:valueTo="360"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
