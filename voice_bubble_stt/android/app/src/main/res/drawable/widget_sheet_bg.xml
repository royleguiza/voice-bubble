<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja de edición del widget y sus diálogos: sólida bg + borde line,
     radio 22 (design.md §13 «Hojas»). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/hz_bg" />
    <stroke android:width="1dp" android:color="@color/hz_line" />
    <corners android:radius="22dp" />
</shape>
