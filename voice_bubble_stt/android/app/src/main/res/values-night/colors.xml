<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paleta Horizonte - modo oscuro (design.md §4). -->
    <color name="hz_bg">#FF08090E</color>
    <color name="hz_surf">#FF12141C</color>
    <color name="hz_surf2">#FF1B1E2A</color>
    <color name="hz_line">#FF262A38</color>
    <color name="hz_fg">#FFF2F0EC</color>
    <color name="hz_fg2">#FF9A9DAB</color>
    <color name="hz_ember">#FFFF8A1F</color>
    <color name="hz_ember_t">#FFFF9A3D</color>
    <color name="hz_ember_soft">#FF3A2410</color>
    <color name="hz_on_ember">#FF1A0E00</color>
    <color name="hz_hot">#FFFFC766</color>
    <color name="hz_plasma">#FF8FB0FF</color>
    <color name="hz_danger">#FFFF6A5C</color>
    <color name="hz_ok">#FF5FD38D</color>
    <color name="hz_hole">#FF000000</color>
    <color name="hz_on_hole">#FFFFE9CF</color>

    <!-- Tokens del teclado - modo oscuro (design.md §12). -->
    <color name="kb_surface">#FF0E1016</color>
    <color name="kb_key_bg">#FF1E212D</color>
    <color name="kb_key_bg_alt">#FF151821</color>
    <color name="kb_key_bg_accent">@color/hz_ember</color>
    <color name="kb_label">@color/hz_fg</color>
    <color name="kb_label_secondary">@color/hz_fg2</color>
    <color name="kb_label_on_accent">@color/hz_on_ember</color>
    <color name="kb_key_pressed">#FF262A38</color>
    <color name="kb_key_stroke">#FF262A38</color>
    <color name="kb_accent_pressed">#FFE5761A</color>
    <color name="kb_recording">@color/hz_ember</color>
    <!-- Borrar / destructivo: único rojo. Texto sobre él: on-ember en oscuro
         (el blanco no llega a 4.5:1 sobre #FF6A5C). -->
    <color name="kb_danger">@color/hz_danger</color>
    <color name="kb_danger_pressed">#FFE85A4D</color>
    <color name="kb_label_on_danger">#FF1A0E00</color>
    <!-- Sin sombra visible en oscuro (maqueta: 0 1px 0 #000 sobre kb). -->
    <color name="kb_key_shadow">#00000000</color>

    <!-- Burbuja flotante (Hito 3): mismos neutros que claro; brasa
         derivada de las variantes noche. -->
    <color name="bubble_idle_bg">#CC12141C</color>
    <color name="bubble_idle_border">#4DFFFFFF</color>
    <color name="bubble_active_border">#80FFFFFF</color>
    <color name="bubble_recording_bg">#E6FF8A1F</color>

    <!-- Historial flotante: tarjeta sólida bg + borde line (fase 4). -->
    <color name="bubble_modal_bg">@color/hz_bg</color>
    <color name="bubble_modal_border">@color/hz_line</color>
    <color name="bubble_legend_bg">@color/hz_surf</color>

    <!-- Icono adaptive / splash (H5-T3): el agujero negro del ícono. -->
    <color name="ic_launcher_background">#FF000000</color>

    <!-- Arranque (Inicio 2026): bg oscuro de design.md. -->
    <color name="splash_background">@color/hz_bg</color>

    <!-- Paleta de snippets - modo oscuro (mismos 6 ids que claro). -->
    <color name="snippet_base_azul">#FF8FB0FF</color>
    <color name="snippet_base_verde">#FF5FD38D</color>
    <color name="snippet_base_rojo">#FFFF6A5C</color>
    <color name="snippet_base_naranja">#FFFFA24A</color>
    <color name="snippet_base_violeta">#FFC79BFF</color>
    <color name="snippet_base_gris">#FF9A9DAB</color>
    <color name="snippet_fill_azul">#338FB0FF</color>
    <color name="snippet_stroke_azul">#668FB0FF</color>
    <color name="snippet_fill_verde">#335FD38D</color>
    <color name="snippet_stroke_verde">#665FD38D</color>
    <color name="snippet_fill_rojo">#33FF6A5C</color>
    <color name="snippet_stroke_rojo">#66FF6A5C</color>
