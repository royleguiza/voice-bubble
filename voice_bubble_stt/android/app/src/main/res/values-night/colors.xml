    <color name="snippet_fill_violeta">#33C79BFF</color>
    <color name="snippet_stroke_violeta">#66C79BFF</color>
    <color name="snippet_fill_gris">#339A9DAB</color>
    <color name="snippet_stroke_gris">#669A9DAB</color>
    <!-- Barra flotante y burbuja (Horizonte fase 4): superficie sólida
         hz_surf + borde hz_line de 1 dp, sin desenfoque de ventana. Íconos
         en fg2; herramienta activa en brasa suave + ember-t (como la barra
         del teclado); presionada en surf2. El micrófono es el agujero
         (HorizonView, modo CORONA). -->
    <color name="dock_surface">@color/hz_surf</color>
    <color name="dock_line">@color/hz_line</color>
    <color name="dock_label">@color/hz_fg2</color>
    <color name="dock_tool_pressed">@color/hz_surf2</color>
    <color name="dock_tool_active">@color/hz_ember_soft</color>
    <color name="dock_tool_active_icon">@color/hz_ember_t</color>
    <color name="dock_track">@color/hz_line</color>
    <color name="dock_handle">@color/hz_fg2</color>
    <color name="dock_pad">@color/hz_surf2</color>
    <color name="dock_pad_line">@color/hz_line</color>
    <color name="dock_hint">@color/hz_fg2</color>
</resources>
