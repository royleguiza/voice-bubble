<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (oscuro activado): el sistema dibuja su propio arranque con
         el ícono adaptativo. Fondo = bgBase de la app, no azul de marca, para
         que el paso a la primera pantalla sea continuo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <!-- El agujero, no el ícono: la animación de Flutter arranca desde acá. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_hole</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
