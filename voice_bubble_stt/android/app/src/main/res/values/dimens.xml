<?xml version="1.0" encoding="utf-8"?>
<!-- Métricas Horizonte del teclado (design.md §12) -->
<resources>
    <dimen name="kb_key_height">48dp</dimen>
    <!-- Fila única del modo mini (MEJ-12): compacta, por debajo del alto
         estándar pero sobre el mínimo táctil. Escala con el perfil. -->
    <dimen name="kb_mini_key_height">40dp</dimen>
    <dimen name="kb_key_gap">6dp</dimen>
    <dimen name="kb_key_gap_h">4dp</dimen>
    <dimen name="kb_key_gap_v">6dp</dimen>
    <!-- Horizonte: tecla 7 dp. -->
    <dimen name="kb_key_radius">7dp</dimen>
    <dimen name="kb_key_stroke_width">1dp</dimen>
    <!-- Línea inferior de la tecla (kb_key_shadow), maqueta Horizonte. -->
    <dimen name="kb_key_shadow_height">1dp</dimen>
    <!-- Barra de herramientas sin cajas (Horizonte fase 2): íconos sueltos,
         radio del estado activo/presionado y área táctil mínima (§9). -->
    <dimen name="kb_tool_radius">10dp</dimen>
    <dimen name="kb_tool_min_target">44dp</dimen>
    <!-- Punto de color del chip de snippet (reemplaza el chip teñido). -->
    <dimen name="kb_snippet_dot_size">6dp</dimen>
    <dimen name="kb_surface_radius">16dp</dimen>
    <dimen name="kb_key_text_size">20sp</dimen>
    <dimen name="kb_key_text_size_small">14sp</dimen>
    <!-- Glifo interno de la tecla shift (+15% sobre small, tarjeta P3). -->
    <dimen name="kb_key_glyph_shift">16sp</dimen>
    <!-- Glifo ↵ del enter (+14% sobre small, tarjeta P4). -->
    <dimen name="kb_key_glyph_enter">16sp</dimen>
    <!-- Glifos , y . de la barra inferior: igualados a 19sp para presencia visual plena. -->
    <dimen name="kb_key_glyph_punct">19sp</dimen>
    <dimen name="kb_row_padding_h">3dp</dimen>
    <dimen name="kb_row_padding_v">6dp</dimen>
    <dimen name="kb_popup_padding">6dp</dimen>
    <dimen name="kb_snippets_grid_height">100dp</dimen>
    <!-- Altura del campo de busqueda de snippets (minimo tactil 48dp, SPK-16). -->
    <dimen name="kb_snippet_search_height">48dp</dimen>
    <!-- Barra slim de snippets (lab compacta): ~mitad de la search clásica.
         Excepción del dueño a SPK-16 solo en esta superficie. -->
    <dimen name="kb_snippet_bar_height">28dp</dimen>
    <!-- Altura de chips de snippets: 40dp (pedido del dueño, más denso
         que la tecla Enter) + tipografía 16sp bold para legibilidad. -->
    <dimen name="kb_snippet_chip_height">40dp</dimen>
    <dimen name="kb_snippet_chip_text_size">16sp</dimen>
    <!-- Respiro entre chips de snippets (márgenes + filas): desacoplado del
         gap de teclas para que los chips no queden apretados. -->
    <dimen name="kb_snippet_chip_gap">10dp</dimen>
</resources>
