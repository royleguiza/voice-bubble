<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Permiso normal (sin impacto Play Protect): háptica del trackpad/píldora vía Vibrator. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Puntero: VoiceBubble NO declara AccessibilityService (perfil
         anti-Play-Protect). Los clics en otras apps los hace el complemento
         VoiceBubble Puntero, que solo acepta órdenes de apps con esta firma.
         El permiso se declara en las DOS apps (misma firma) para que el orden
         de instalación no importe. Ver docs/contrato-trackpad.md. -->
    <permission
        android:name="com.royleguiza.voicebubble.puntero.permission.POINTER"
        android:protectionLevel="signature"/>
    <uses-permission android:name="com.royleguiza.voicebubble.puntero.permission.POINTER"/>
    <application
        android:label="VoiceBubble STT"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasFragileUserData="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <service
            android:name=".FloatingBubbleService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- Trackpad flotante (lo abre la barra): servicio NORMAL (no foreground,
             no accesibilidad), exported=false. Sin él, startService lanza
             IllegalArgumentException (CR-2). Sin BIND_ACCESSIBILITY_SERVICE por
             perfil anti-Play-Protect: los clics en otra app van por el
             complemento VoiceBubble Puntero (PointerLink). -->
        <service
            android:name=".FloatingTrackpadService"
            android:exported="false" />

        <!-- Sin AccessibilityService por perfil anti-Play-Protect (2026-09-05):
             vive en el complemento aparte (puntero_android/). Ver AGENTS.md Estado. -->
        <service
            android:name=".VoiceKeyboardService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method"/>
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clipboardfileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clipboard_file_paths" />
        </provider>
        <receiver android:name=".WidgetNotesProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- Al instalar una versión nueva el launcher puede volver al
                 diseño inicial (vacío, sin acciones en + ni micrófono): se
                 redibuja enseguida. -->
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_notes_info" />
        </receiver>
        <service
            android:name=".WidgetDictationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Fase 2A: la barra flotante la dibuja el complemento VoiceBubble Puntero
             (ventanas de Accesibilidad, siempre vivas). Su micrófono dicta con este
             servicio NATIVO, sin Flutter. Exportado SOLO con el permiso de firma:
             ninguna otra app puede arrancarlo. -->
        <service
            android:name=".DockDictationService"
            android:exported="true"
            android:permission="com.royleguiza.voicebubble.puntero.permission.POINTER"
            android:foregroundServiceType="microphone|shortService" />
        <!-- Respaldo del servicio anterior: si Android no deja arrancar el micrófono
             desde segundo plano, el complemento abre esta actividad translúcida, que lo
             arranca en primer plano y se cierra sola. También solo con el permiso de firma. -->
        <activity
            android:name=".DockTrampolineActivity"
            android:exported="true"
            android:permission="com.royleguiza.voicebubble.puntero.permission.POINTER"
            android:theme="@style/DockTrampolineTheme"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />
        <!-- Hola / estado de la barra del complemento. En el MANIFIESTO para que
             funcione con la app cerrada (Android la despierta): tras reiniciar, el
             complemento pide su configuración y la barra vuelve sola. -->
        <receiver
            android:name=".DockLinkReceiver"
            android:exported="true"
            android:permission="com.royleguiza.voicebubble.puntero.permission.POINTER">
            <intent-filter>
                <action android:name="com.royleguiza.voicebubble.puntero.ACTION_DOCK_HELLO" />
                <action android:name="com.royleguiza.voicebubble.puntero.ACTION_DOCK_STATE" />
                <action android:name="com.royleguiza.voicebubble.puntero.ACTION_DOCK_HISTORY" />
            </intent-filter>
        </receiver>
        <!-- Colección con scroll del widget (pendientes + notas):
             el launcher la consulta vía RemoteViewsFactory. Sin este
             permiso el ListView queda vacío. -->
        <service
            android:name=".WidgetNotesListService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <!-- Nota abierta dentro del widget: acciones (no exportado: solo
             nuestros PendingIntent) y texto con scroll. -->
        <receiver
            android:name=".WidgetReaderReceiver"
            android:exported="false" />
        <service
            android:name=".WidgetNoteDetailService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <activity
            android:name=".WidgetNoteEditActivity"
            android:theme="@style/WidgetEditTheme"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:launchMode="singleTop"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Saber si el complemento VoiceBubble Puntero está instalado. -->
        <package android:name="com.royleguiza.voicebubble.puntero"/>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
